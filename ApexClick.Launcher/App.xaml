<Application x:Class="ApexClick.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ApexClick.Views.Converters;assembly=ApexClick.Views">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="pack://application:,,,/ApexClick.Views;component/Styles/DesignTokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ApexClick.Views;component/Styles/ControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:RecordButtonLabelConverter x:Key="RecordButtonLabelConverter" />
            <conv:PauseResumeButtonLabelConverter x:Key="PauseResumeButtonLabelConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
