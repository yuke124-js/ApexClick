<Window x:Class="ApexClick.Launcher.LauncherShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ApexClick.ViewModels;assembly=ApexClick.ViewModels"
        xmlns:views="clr-namespace:ApexClick.Views;assembly=ApexClick.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ApexClick" Height="720" Width="1200"
        MinHeight="480" MinWidth="800"
        Background="{StaticResource GraphiteInkBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:AutomationModuleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SchedulerFunctionViewModel}">
            <views:SchedulerFunctionView />
        </DataTemplate>

        <Style x:Key="ModulePillStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource SteelGreyBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PillBorder" CornerRadius="9"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PillBorder" Property="Background"
                                        Value="{StaticResource SignalPulseGradientBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource FogWhiteBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource GraphiteInkBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="APEXCLICK" Style="{StaticResource BrandTextStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                <Button Content="&#8211;" Style="{StaticResource TitleBarButtonStyle}"
                        Click="Minimize_Click" Margin="0,0,8,0" />
                <Button Content="&#10005;" Style="{StaticResource TitleBarButtonStyle}"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}" CornerRadius="0" Padding="12,8">
            <ListBox ItemsSource="{Binding Modules}"
                     SelectedItem="{Binding SelectedModule}"
                     DisplayMemberPath="DisplayName"
                     ItemContainerStyle="{StaticResource ModulePillStyle}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding SelectedModule.ContentViewModel}" />
    </Grid>
</Window>
