<Window x:Class="ApexClick.Views.NodePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" Height="500" WindowStartupLocation="CenterOwner"
        Background="{StaticResource GraphiteInkBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Отмена" Click="OnCancel" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" />
            <Button Content="Сохранить" Click="OnSave" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Свойства узла" Style="{StaticResource UiTextStyle}" Margin="0,0,0,12" />
                <TextBlock Text="Тип" Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock x:Name="TypeText" Style="{StaticResource UiTextStyle}" Margin="0,2,0,10" />

                <TextBlock Text="Expression / имя / путь / OCR-текст" Style="{StaticResource SecondaryTextStyle}" />
                <TextBox x:Name="Value1" Margin="0,4,0,8" />

                <TextBlock Text="Дополнительное значение / assetId / threshold" Style="{StaticResource SecondaryTextStyle}" />
                <TextBox x:Name="Value2" Margin="0,4,0,8" />

                <TextBlock Text="Параметры node" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="X" Grid.Row="0" Margin="0,0,8,4" />
                    <TextBox x:Name="PropX" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" />
                    <TextBlock Text="Y" Grid.Row="1" Margin="0,0,8,4" />
                    <TextBox x:Name="PropY" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" />
                    <TextBlock Text="Tolerance" Grid.Row="2" Margin="0,0,8,4" />
                    <TextBox x:Name="PropTolerance" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" />
                    <TextBlock Text="Region W" Grid.Row="3" Margin="0,0,8,4" />
                    <TextBox x:Name="PropW" Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" />
                    <TextBlock Text="Region H" Grid.Row="4" Margin="0,0,8,4" />
                    <TextBox x:Name="PropH" Grid.Row="4" Grid.Column="1" Margin="0,0,0,4" />
                    <TextBlock Text="Pixel RGB" Grid.Row="5" Margin="0,0,8,4" />
                    <TextBox x:Name="PropRgb" Grid.Row="5" Grid.Column="1" Margin="0,0,0,4" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
