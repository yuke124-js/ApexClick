<Window x:Class="ApexClick.Views.ImageTemplateLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexClick — Библиотека изображений" Width="520" Height="420"
        Background="{StaticResource GraphiteInkBrush}" WindowStartupLocation="CenterOwner"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Выбрать файлы…" Click="OnBrowse" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" />
            <Button Content="Закрыть" Click="OnClose" Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
        <Border Style="{StaticResource PanelBorderStyle}" Padding="12" Margin="0,0,0,10"
                BorderBrush="{StaticResource SteelGreyBrush}" AllowDrop="True">
            <StackPanel>
                <TextBlock Text="Перетащите изображения сюда" Style="{StaticResource UiTextStyle}" />
                <TextBlock Text="PNG / JPG / JPEG / BMP / WEBP. Файл станет embedded asset .mscr и сразу создаст ConditionScreenTemplate." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
        <ListBox x:Name="AssetList" Background="Transparent" BorderThickness="0" />
    </DockPanel>
</Window>
