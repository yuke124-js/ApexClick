<UserControl x:Class="ApexClick.Views.AutomationModuleView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:feature="clr-namespace:ApexClick.FeaturePack.UI;assembly=ApexClick.FeaturePack"
        Background="{StaticResource GraphiteInkBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" CornerRadius="0" Padding="12,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Style="{StaticResource RecordingIndicatorDotStyle}" Margin="0,0,8,0"
                         Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Content="{Binding IsRecording, Converter={StaticResource RecordButtonLabelConverter}}"
                        Command="{Binding StartStopRecordingCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                        ToolTip="ⓘ F6 — начать или остановить запись мыши и клавиатуры." />

                <Button Content="▶ Воспроизвести" Command="{Binding PlayLastScriptCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                        ToolTip="ⓘ F5 — воспроизведение текущего/последнего сценария" />

                <Button Content="■ Стоп" Command="{Binding StopPlaybackCommand}" ToolTip="ⓘ Остановить текущее воспроизведение."
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />

                <Button Content="🔌 Плагины" Click="OnOpenPluginsClick" ToolTip="ⓘ Управление подключёнными graph-node plugins." Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />

                <Button Content="⚙ Настройки" Click="OnOpenSettingsClick" ToolTip="ⓘ Настройки записи, аудио/микрофона, графа, Vision, AI, приватности и хоткеев." Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />

                <Button Content="🐞 Отладчик" Click="OnOpenDebuggerClick" ToolTip="ⓘ Пошаговое выполнение, breakpoints и просмотр переменных." Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />

                <TextBlock Text="Скорость:" Style="{StaticResource SecondaryTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider Minimum="0.5" Maximum="2.0" Value="{Binding PlaybackSpeed}"
                        Width="120" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PlaybackSpeed, StringFormat={}{0:0.0}x}"
                           Style="{StaticResource DataTextStyle}" VerticalAlignment="Center" Margin="6,0,16,0" />

                <TextBlock Text="{Binding RecordedStepCount, StringFormat=Записано шагов: {0}}"
                           Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"
                           Visibility="{Binding IsRecording, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,1,0" Background="{StaticResource SlatePanelBrush}">
                <TextBlock DockPanel.Dock="Top" Text="Библиотека сценариев" Style="{StaticResource SecondaryTextStyle}" Margin="12,12,12,4" />
                <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,12">
                    <Button Content="✎  Открыть граф" Click="OnOpenEditorClick"
                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"
                            ToolTip="ⓘ Открывает отдельное окно визуального редактора; главное окно остаётся лёгким." />
                    <Button Content="Удалить выбранный" Command="{Binding DeleteSelectedScriptCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                            ToolTip="ⓘ Удаляет выбранный сценарий из библиотеки." />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,8">
                    <TextBlock Text="Расписание" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding ScheduledJobs}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource DataTextStyle}" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ScriptName, Mode=OneWay}" /> <Run Text="/" />
                                        <Run Text="{Binding Interval.TotalMinutes, Mode=OneWay, StringFormat={}{0:0.#} мин}" />
                                    </TextBlock>
                                    <Button Grid.Column="1" Content="×" Width="20" Padding="0"
                                            Command="{Binding DataContext.CancelScheduleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding ScheduleIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,4,0" />
                        <TextBlock Text="мин." Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="Запланировать" Command="{Binding ScheduleSelectedCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
                <ListBox ItemsSource="{Binding ScriptLibrary}" SelectedItem="{Binding SelectedScript}"
                         Background="Transparent" BorderThickness="0" Margin="6,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6,4">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource UiTextStyle}" />
                                <TextBlock Style="{StaticResource DataTextStyle}">
                                    <Run Text="{Binding Events.Count, Mode=OneWay}" /> <Run Text="шагов" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="1" Margin="8,0" Background="{StaticResource GraphiteInkBrush}">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                        <Border Background="{StaticResource SlatePanelBrush}" BorderBrush="{StaticResource SteelGreyBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="28">
                            <StackPanel>
                                <TextBlock Text="NODE GRAPH" Style="{StaticResource UiTextStyle}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Визуальное редактирование сценария — отдельное окно"
                                           Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,4" />
                                <TextBlock Text="Основное окно остаётся лёгким: граф и его превью загружаются только при открытии редактора."
                                           Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,18" />
                                <Button Content="Открыть редактор графа"
                                        Click="OnOpenEditorClick"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Padding="18,9"
                                        ToolTip="Открывает отдельное окно Node Graph. При закрытии программа предложит сохранить изменения." />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock Text="ⓘ" Style="{StaticResource InfoGlyphStyle}" ToolTip="Редактор поддерживает действия, условия, циклы, переменные, image-триггеры и связи между узлами." />
                            <TextBlock Text="Граф не загружается в главном окне до нажатия кнопки."
                                       Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" CornerRadius="0" Margin="1,0,0,0">
                <StackPanel Margin="12" DataContext="{Binding SelectedScript}">
                    <TextBlock Text="Инспектор сценария" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource UiTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource DataTextStyle}" Margin="0,4,0,0">
                        <Run Text="Шагов: " /><Run Text="{Binding Events.Count, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource DataTextStyle}" Margin="0,4,0,0">
                        <Run Text="Скорость: " /><Run Text="{Binding PlaybackSpeedMultiplier, Mode=OneWay, StringFormat={}{0:0.0}x}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Expander Grid.Row="2" Margin="0,1,0,0" Background="{StaticResource SlatePanelBrush}" BorderThickness="0" IsExpanded="False"
                  ToolTip="ⓘ Дополнительные инструменты: лицензия, Data-driven, Community, Debugger, Plugins и экспорт.">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Расширенные инструменты" Style="{StaticResource UiTextStyle}"/>
                    <TextBlock Text="ⓘ" Style="{StaticResource InfoGlyphStyle}" ToolTip="Эти функции не нужны для обычной записи/воспроизведения и поэтому скрыты, чтобы главное окно оставалось спокойным." Margin="8,0,0,0"/>
                </StackPanel>
            </Expander.Header>
            <Border Style="{StaticResource PanelBorderStyle}" CornerRadius="0" Padding="12,8">
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBox Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,4,0" ToolTip="ⓘ Ключ лицензии ApexClick."/>
                        <Button Content="Активировать" Command="{Binding ActivateLicenseCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="ⓘ Сохранить и проверить лицензионный ключ."/>
                        <Button Content="Проверить онлайн" Command="{Binding ValidateOnlineLicenseCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="ⓘ Проверить актуальность ключа у license server."/>
                    </StackPanel>
                    <Button Content="Data-driven CSV" Command="{Binding RunDataDrivenCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="ⓘ Выполнить сценарий для строк CSV с подстановкой ${Колонка}."/>
                    <StackPanel Orientation="Horizontal" Margin="12,0,16,4">
                        <ComboBox ItemsSource="{Binding CommunityCategories}" SelectedItem="{Binding CommunityCategory}" Width="120" Margin="0,0,4,0" ToolTip="ⓘ Разрешённая категория публикации Community."/>
                        <Button Content="Опубликовать" Command="{Binding PublishToCommunityCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="ⓘ Отправить сценарий в Community после проверки правил."/>
                    </StackPanel>
                    <Button Content="Шаг отладки" Command="{Binding StepDebuggerCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="ⓘ Выполнить следующий semantic/debug шаг."/>
                    <Button Content="Сброс debugger" Command="{Binding ResetDebuggerCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="ⓘ Сбросить состояние отладчика."/>
                    <Button Content="Экспорт EXE" Command="{Binding ExportStandaloneCommand}" Style="{StaticResource SecondaryButtonStyle}" ToolTip="ⓘ Собрать standalone Windows EXE из сценария."/>
                    <TextBlock Text="{Binding PluginStatusText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,0,4" ToolTip="ⓘ Статус registry сторонних graph plugins."/>
                </WrapPanel>
            </Border>
        </Expander>

        <Border Grid.Row="3" Style="{StaticResource PanelBorderStyle}" CornerRadius="0" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource DataTextStyle}" TextTrimming="CharacterEllipsis" />
        </Border>

        <feature:RecordingPulseLine Grid.RowSpan="4" IsActive="{Binding IsRecording}"
                                    PulseToken="{Binding RecordingPulseToken}"
                                    VerticalAlignment="Top" />
    </Grid>
</UserControl>
