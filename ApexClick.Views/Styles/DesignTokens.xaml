<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="GraphiteInkColor">#000000</Color>
    <Color x:Key="SlatePanelColor">#0A0A0A</Color>
    <Color x:Key="FogWhiteColor">#FFFFFF</Color>
    <Color x:Key="SteelGreyColor">#999999</Color>

    <Color x:Key="GlowWhiteColor">#FFFFFF</Color>
    <Color x:Key="GlowBorderColor">#24FFFFFF</Color>

    <Color x:Key="GlowBorderHoverColor">#80FFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#1FFFFFFF</Color>
    <Color x:Key="SurfaceIdleColor">#0AFFFFFF</Color>

    <Color x:Key="EmberRedColor">#FF4D4D</Color>

    <SolidColorBrush x:Key="GraphiteInkBrush" Color="{StaticResource GraphiteInkColor}" />
    <SolidColorBrush x:Key="SlatePanelBrush" Color="{StaticResource SlatePanelColor}" />
    <SolidColorBrush x:Key="FogWhiteBrush" Color="{StaticResource FogWhiteColor}" />
    <SolidColorBrush x:Key="SteelGreyBrush" Color="{StaticResource SteelGreyColor}" />
    <SolidColorBrush x:Key="EmberRedBrush" Color="{StaticResource EmberRedColor}" />

    <SolidColorBrush x:Key="GlowBorderBrush" Color="{StaticResource GlowBorderColor}" />
    <SolidColorBrush x:Key="GlowBorderHoverBrush" Color="{StaticResource GlowBorderHoverColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceIdleBrush" Color="{StaticResource SurfaceIdleColor}" />

    <SolidColorBrush x:Key="SignalPulseGradientBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SignalBlueBrush" Color="{StaticResource FogWhiteColor}" />

    <SolidColorBrush x:Key="PulseLineBrush" Color="{StaticResource GlowWhiteColor}" />

    <FontFamily x:Key="UiFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="DataFontFamily">Cascadia Code, Consolas</FontFamily>

    <Style x:Key="BrandTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource FogWhiteBrush}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="White" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
