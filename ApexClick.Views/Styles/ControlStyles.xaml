<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SlatePanelBrush}" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style x:Key="UiTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource FogWhiteBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource UiTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource SteelGreyBrush}" />
    </Style>

    <Style x:Key="DataTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DataFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource SteelGreyBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="RecordingIndicatorDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Fill" Value="{StaticResource EmberRedBrush}" />
    </Style>

    <Style x:Key="SettingCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource FogWhiteBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="Margin" Value="0,5,0,5" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource FogWhiteBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource SurfaceIdleColor}" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource GlowBorderColor}" />
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect x:Name="Glow" Color="White" ShadowDepth="0" BlurRadius="0" Opacity="0" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource SurfaceHoverColor}" Duration="0:0:0.2" />
                                        <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource GlowBorderHoverColor}" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius"
                                                         To="20" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         To="0.6" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource SurfaceIdleColor}" Duration="0:0:0.3" />
                                        <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="BorderBrush.Color"
                                                        To="{StaticResource GlowBorderColor}" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius"
                                                         To="0" Duration="0:0:0.3" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource SteelGreyBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,4,4" />
    </Style>

    <Style x:Key="InfoGlyphStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SteelGreyBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Help" />
    </Style>

    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource FogWhiteBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="16" BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource SurfaceIdleColor}" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource GlowBorderColor}" />
                        </Border.BorderBrush>
                        <Border.Effect>
                            <DropShadowEffect x:Name="Glow" Color="White" ShadowDepth="0" BlurRadius="0" Opacity="0" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource SurfaceHoverColor}" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius"
                                                         To="16" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         To="0.55" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource SurfaceIdleColor}" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="BlurRadius"
                                                         To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlowCardStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource SurfaceIdleColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource GlowBorderColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="0" Opacity="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource SurfaceHoverColor}" Duration="0:0:0.25" />
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource GlowBorderHoverColor}" Duration="0:0:0.25" />
                            <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius"
                                             To="24" Duration="0:0:0.3" />
                            <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                             To="0.5" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                                            To="{StaticResource SurfaceIdleColor}" Duration="0:0:0.3" />
                            <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color"
                                            To="{StaticResource GlowBorderColor}" Duration="0:0:0.3" />
                            <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius"
                                             To="0" Duration="0:0:0.3" />
                            <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                             To="0" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
