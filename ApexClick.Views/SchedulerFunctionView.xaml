<UserControl x:Class="ApexClick.Views.SchedulerFunctionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource GraphiteInkBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="ПЛАНИРОВЩИК" Style="{StaticResource UiTextStyle}" VerticalAlignment="Center" />
            <TextBlock Text=" · запуск сценариев по интервалу" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorderStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="Новый запуск" Style="{StaticResource UiTextStyle}" />
                    <ComboBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}" DisplayMemberPath="Name" Margin="0,10,0,8" />
                    <TextBlock Text="Интервал, минут" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBox Text="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,4,0,8" />
                    <Button Content="Запланировать" Command="{Binding ScheduleCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                    <TextBlock Text="{Binding SchedulerInfo}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Padding="12" Margin="10,0,0,0">
                <ItemsControl ItemsSource="{Binding Jobs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ScriptName}" Style="{StaticResource UiTextStyle}" />
                                    <TextBlock Text="{Binding Interval.TotalMinutes, StringFormat={}{0:0.#} мин}" Style="{StaticResource DataTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="×" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" Width="28" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
