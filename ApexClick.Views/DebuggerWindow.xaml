<Window x:Class="ApexClick.Views.DebuggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ApexClick — Отладчик графа" Width="900" Height="620"
        Background="{StaticResource GraphiteInkBrush}" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="▶ Шаг графа" Click="OnStepGraph" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" />
            <Button Content="▶ Шаг события" Click="OnStepEvent" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" />
            <Button Content="↺ Сброс" Click="OnReset" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,18,0" />
            <TextBlock Text="Текущий узел:" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            <TextBlock x:Name="CurrentNodeText" Text="—" Style="{StaticResource UiTextStyle}" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorderStyle}" Padding="10">
                <ListBox x:Name="EventList" Background="Transparent" BorderThickness="0" />
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}" Padding="10" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Variables" Style="{StaticResource UiTextStyle}" />
                    <ItemsControl x:Name="VariableList" Margin="0,8,0,0" />
                    <TextBlock Text="Debug" Style="{StaticResource UiTextStyle}" Margin="0,18,0,4" />
                    <TextBlock x:Name="DebugText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
