<UserControl x:Class="ApexClick.FeaturePack.UI.RecordingPulseLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="26" IsHitTestVisible="False">
    <Grid>
        <Path x:Name="PulsePath" Stroke="{DynamicResource PulseLineBrush}" StrokeThickness="2"
              Data="M 0,13 L 120,13 L 140,13 L 155,7 L 170,19 L 185,13 L 310,13" Stretch="Fill" />
    </Grid>
</UserControl>
