<UserControl x:Class="ApexClick.FeaturePack.UI.NodeGraphCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource GraphiteInkBrush}">
    <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="OnViewportChanged">
        <Canvas x:Name="Canvas" Width="2600" Height="1800" Background="Transparent" SizeChanged="OnCanvasSizeChanged"/>
    </ScrollViewer>
</UserControl>
